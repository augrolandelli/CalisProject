{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CalisAppDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Jwt": {
    "Key": "dev-only-key-cambiar-en-produccion-0123456789abcdef"
  },
  "Push": {
    "VapidPublicKey": "YOUR_VAPID_PUBLIC_KEY",
    "VapidPrivateKey": "YOUR_VAPID_PRIVATE_KEY",
    "Subject": "mailto:admin@calisapp.com"
  }
}

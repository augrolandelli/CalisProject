# Variables de entorno para docker-compose.prod.yml
# Copiar este archivo como .env y completar los valores.
# NUNCA subir .env al repo.

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres, mayúscula, minúscula, número y símbolo).
MSSQL_SA_PASSWORD=Cambiame_123!

# Clave JWT: generar con openssl rand -base64 32 (mínimo 32 caracteres).
JWT_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-al-menos-32-caracteres

# URL del frontend en Vercel (o dominio propio). Debe coincidir con CORS.
FRONTEND_URL=https://calisapp.vercel.app

# Claves VAPID para Web Push (opcional para la beta; dejar vacío si aún no las tenés).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@calisapp.com
